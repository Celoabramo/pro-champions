# Copie esse arquivo pra ".env" (sem o .example) e preencha com os valores reais.
# O .env NUNCA deve ser commitado — ele fica só na sua máquina.

# Em produção (Railway), aponta pra um Postgres — sem essa variável o app
# usa SQLite em arquivo (bom só pra rodar local, se perde a cada deploy).
# ATENÇÃO se usar Supabase: o host direto (db.<ref>.supabase.co) só
# responde em IPv6, e o Railway não alcança IPv6 por padrão — use o
# "Connection Pooler" do Supabase (host tipo aws-0-<região>.pooler.supabase.com,
# porta 6543, usuário "<usuario>.<ref-do-projeto>"), que é IPv4.
DATABASE_URL=

# Chave da sua conta AbacatePay (painel > API Keys). Obrigatória pra gerar Pix.
ABACATEPAY_API_KEY=

# Secret usado pra validar a assinatura do webhook da AbacatePay. Opcional:
# sem ele, a confirmação automática de pagamento não funciona, mas o botão
# manual "já paguei, verificar" continua funcionando normalmente.
ABACATEPAY_WEBHOOK_SECRET=

# Defina como 1 pra mostrar o botão "Simular pagamento" na tela do Pix
# (só funciona com uma chave de sandbox/teste da AbacatePay).
ABACATEPAY_MODO_TESTE=

# Chave da sua conta Anthropic (console.anthropic.com > API Keys). Usada
# pra ler automaticamente o placar dos prints enviados pelos capitães.
ANTHROPIC_API_KEY=

# Uma chave secreta de verdade (aleatória, longa) pra proteger sessão de
# login e os formulários. OBRIGATÓRIO trocar antes de colocar no ar —
# sem isso, o app usa uma chave fixa que qualquer um vê no código.
SECRET_KEY=

# Defina como 1 só na sua máquina, pra rodar em modo debug (reload
# automático e mensagens de erro detalhadas). NUNCA deixe como 1 no site
# no ar — o modo debug deixa qualquer erro abrir um console que executa
# código Python.
FLASK_DEBUG=

# Envio de e-mail (usado pro "esqueci minha senha" e pra contestação de
# placar) via Resend (resend.com/api-keys) — API HTTPS, não SMTP, porque
# a Railway bloqueia SMTP de saída nos planos Free/Trial/Hobby.
# EMAIL_REMETENTE precisa ser um endereço de um domínio verificado em
# resend.com/domains (ex: suporte@prochampions.com.br) — sem isso, o
# Resend só deixa mandar pro próprio e-mail da conta (modo de teste).
# Sem essas 2 variáveis, o link de redefinição não é enviado (mas o
# resto do site funciona normal).
RESEND_API_KEY=
EMAIL_REMETENTE=
